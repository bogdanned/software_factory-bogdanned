    "seed:backlog": "node --env-file-if-exists=.env scripts/seed-backlog.mjs",
    "factory:metrics": "node factory/scripts/metrics.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1147.0",
    "@base-ui/react": "^1.8.0",
